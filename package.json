{
  "name": "@openswitchboard/server",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openswitchboard-ai/server.git"
  },
  "description": "OpenSwitchboard core switchboard service: MCP endpoint, OAuth 2.1, domain core, screening pipeline.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "lint": "tsc --noEmit",
    "start": "node dist/src/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run test/unit test/conformance.local.test.ts",
    "test:integration": "RUN_INTEGRATION=1 vitest run --no-file-parallelism test/integration",
    "build:gazetteer": "tsx scripts/build-gazetteer.ts",
    "bootstrap-account": "tsx scripts/bootstrap-account.ts",
    "ops": "tsx scripts/ops.ts",
    "test:e2e": "playwright test test/e2e/counter.spec.ts test/e2e/passkey.spec.ts",
    "test:e2e:prod": "OSB_CHECK_PROD=1 playwright test test/e2e/prod.spec.ts",
    "sim": "RUN_SIM=1 tsx test/sim/run.ts",
    "sim:clean": "RUN_SIM=1 tsx test/sim/run.ts --clean",
    "sim:typecheck": "tsc -p test/sim/tsconfig.json"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.700.0",
    "@aws-sdk/client-kms": "^3.700.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/client-secrets-manager": "^3.700.0",
    "@aws-sdk/client-sesv2": "^3.1121.0",
    "@aws-sdk/client-sqs": "^3.700.0",
    "@aws-sdk/client-ssm": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.1121.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@openswitchboard/schema": "github:openswitchboard-ai/schema#main",
    "@simplewebauthn/server": "^13.3.3",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "argon2": "^0.45.1",
    "fastify": "^5.2.0",
    "pg": "^8.13.0",
    "stripe": "^22.6.0"
  },
  "devDependencies": {
    "@aws-sdk/client-rds-data": "^3.1121.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
