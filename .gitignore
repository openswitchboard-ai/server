node_modules/
dist/
*.log
.env
.env.*
!.env.example
test-results/
playwright-report/
e2e-screenshots/
realism-reports/
# Agent worktrees and local agent config. These hold full copies of the repo
# and must never be committed.
.claude/
cdk.out/
*.pem
*.key

# Test-agent credential files written by the dev reset script. Never commit.
bilby-fixed.json
nagatha-fresh.json
*-fresh.json
*-fixed.json

# The known-image check's optional module (vendor/known-image/README.md).
# Never committed: a deployment puts it beside that README on the way past.
# Only the README is in git. vendor/photodna is where it used to sit, and
# stays ignored so an old checkout's files cannot be committed by accident.
vendor/known-image/*
!vendor/known-image/README.md
vendor/photodna/

# Working artefacts rendered from public code for review, not source:
# scripts/render-category-phrases.ts writes here by default.
docs/category-phrases.html
